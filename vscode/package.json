{
  "name": "tweakr-dev",
  "displayName": "Tweakr Visual Editor",
  "description": "Edit your UI visually from the browser. Hover over any element, edit text, change styles, delete elements — source code updates instantly.",
  "version": "0.0.6",
  "publisher": "hassanlasheenn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hassanlasheenn/tweakr.git"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "tweakr",
    "visual-editor",
    "css",
    "dom",
    "ui-editor",
    "frontend",
    "design",
    "live-edit",
    "react",
    "chrome"
  ],
  "activationEvents": [
    "workspaceContains:src/**",
    "workspaceContains:index.html",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tweakr.start",
        "title": "Tweakr: Start Server"
      },
      {
        "command": "tweakr.stop",
        "title": "Tweakr: Stop Server"
      },
      {
        "command": "tweakr.restart",
        "title": "Tweakr: Restart Server"
      },
      {
        "command": "tweakr.stats",
        "title": "Tweakr: Show Usage Stats"
      }
    ],
    "configuration": {
      "title": "Tweakr",
      "properties": {
        "tweakr.port": {
          "type": "number",
          "default": 3333,
          "description": "Port for the Tweakr bridge server"
        },
        "tweakr.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the server when a project is opened"
        }
      }
    }
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#d97706",
    "theme": "dark"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
