{
  "name": "tweakr-extension",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Tweakr — Chrome extension for hover-to-edit DOM elements with live CSS editing",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,css,json,html}\"",
    "format:check": "prettier --check \"**/*.{js,css,json,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run test && npm run format:check && npm run lint"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "vitest": "^4.1.5"
  }
}
