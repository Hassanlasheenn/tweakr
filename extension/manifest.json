{
  "manifest_version": 3,
  "name": "Tweakr",
  "version": "0.0.4",
  "description": "Stop digging through files. Hover over any element, edit it visually, and watch your source code update instantly.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3333/*"],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "24": "icon24.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
